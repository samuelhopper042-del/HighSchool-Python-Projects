import json
import os


FILENAME = "study_guide.json"


def load_topics():
    """Loads study topics from a file. Returns an empty list if no file exists."""
    if os.path.exists(FILENAME):
        try:
            with open(FILENAME, "r") as file:
                return json.load(file)
        except json.JSONDecodeError:
            print("Warning: Save file was corrupted. Starting fresh.")
            return []
    return []


def save_topics(topics):
    """Saves the current study list to a file."""
    try:
        with open(FILENAME, "w") as file:
            json.dump(topics, file)
    except IOError:
        print("Error: Could not save your topics to disk.")


# Load existing data at startup
study_list = load_topics()


print("=== My Simple Study Guide Manager ===")


while True:
    print("\n--------------------------------")
    print("1. Add a new study topic")
    print("2. View and scroll my topics")
    print("3. Edit an existing topic")
    print("4. Delete a topic")
    print("5. Reset/Clear all topics")
    print("6. Exit app")

  
    choice = input("\nChoose an option (1-6): ").strip()

  
    if choice == "1":
        new_topic = input("Type what you need to study: ").strip()
        if new_topic:
            study_list.append(new_topic)
            save_topics(study_list) # Auto-save
            print(f"Added: '{new_topic}'")
        else:
            print("Topic cannot be empty!")



